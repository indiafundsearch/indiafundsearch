# Sanity — fill these after running `npx sanity@latest init` in this repo
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Server-only token used by /api/lead-capture to write leadCapture documents.
# Create at https://www.sanity.io/manage → Project → API → Tokens (Editor or Write).
SANITY_API_WRITE_TOKEN=

# Resend (transactional email for lead capture replies)
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@indiafundsearch.com

# Used by /api/revalidate webhook handler from Sanity.
SANITY_REVALIDATE_SECRET=

# Public site URL (used by next-sitemap and OG tags)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Plausible analytics — leave blank in dev. Set in Vercel for production.
# v4 uses the per-site script URL from your Plausible dashboard,
# e.g. https://plausible.io/js/pa-XXXXX.js
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_SRC=
